IOL_API_ENABLED=true
IOL_USE_REAL_PORTFOLIO=true
IOL_USERNAME=tu_usuario_iol
IOL_PASSWORD=tu_password_iol

# Finanzas
HOST=127.0.0.1
FINANZAS_API_TOKEN=generar_con_openssl_rand_hex_32
FINANZAS_PUBLIC_URL=https://tu-host.ts.net/finanzas
# FINANZAS_DB=data/finanzas.db

# Web UI login (generate the hash with: node lib/auth.js 'your-password')
FINANZAS_LOGIN_USER=tu_usuario
FINANZAS_LOGIN_HASH=
FINANZAS_SESSION_SECRET=generar_con_openssl_rand_hex_32

# Construction expense sheet (optional). The service account needs read access to the sheet.
# OBRA_SHEET_ID=id_de_la_planilla
# OBRA_SHEET_RANGE=Gastos!A:I
# GOOGLE_SERVICE_ACCOUNT_FILE=/ruta/a/service-account.json
# OBRA_LABEL=Obra
# OBRA_CATEGORY=Obra
# OBRA_LINK_CATEGORIES=Construccion casa,Transferencias a personas,Hogar y construcción
